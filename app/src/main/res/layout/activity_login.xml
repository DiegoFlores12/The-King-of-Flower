<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fk_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The King of Flower"
        android:textColor="@color/fk_accent_green"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Monitoreo y administración de huertas"
        android:textColor="@color/fk_text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUser"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_card"
        android:hint="Nombre de usuario"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="@color/fk_text_primary"
        android:textColorHint="@color/fk_text_secondary" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/fk_text_primary"
        android:textColorHint="@color/fk_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/fk_accent_green"
        android:text="Ingresar al Huerto"
        android:textColor="@color/fk_bg"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tvGoToRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="8dp"
        android:text="Crear Usuario"
        android:textColor="@color/fk_accent_blue"
        android:textSize="14sp" />

</LinearLayout>